APP_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE_MINUTES=90
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20
ALLOW_LATE_SUBMISSIONS=true
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./private_uploads
DATABASE_URL=sqlite:///./portal.db

# Local-only demo identities; replace these before sharing a deployment.
DEMO_TEACHER_EMAIL=teacher@example.edu
DEMO_TEACHER_PASSWORD=Local-Demo-Teacher-2026
DEMO_STUDENT_EMAIL=student@example.edu
DEMO_STUDENT_PASSWORD=Local-Demo-Student-2026

# Docker Compose PostgreSQL values. Use unique local-only values.
POSTGRES_USER=portal
POSTGRES_PASSWORD=replace-this-local-postgres-password
POSTGRES_DB=portal

# Optional S3-compatible private object storage.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=